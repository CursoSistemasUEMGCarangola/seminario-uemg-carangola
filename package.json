{
  "name": "seminario-uemg-carangola-pwa",
  "version": "1.0.0",
  "private": true,
  "description": "Progressive Web Application (PWA) para o Seminário de Pesquisa e Extensão da UEMG Carangola",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build:data": "node scripts/compile-data.js",
    "build:icons": "node scripts/generate-icons.js",
    "build": "npm run build:data && tsc && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src/ --ext .ts",
    "format": "prettier --write \"src/**/*.{ts,html,css}\" \"scripts/**/*.js\""
  },
  "dependencies": {},
  "devDependencies": {
    "@types/node": "^22.10.1",
    "@typescript-eslint/eslint-plugin": "^8.18.0",
    "@typescript-eslint/parser": "^8.18.0",
    "autoprefixer": "^10.4.20",
    "csv-parse": "^5.6.0",
    "eslint": "^9.16.0",
    "iconv-lite": "^0.6.3",
    "postcss": "^8.4.49",
    "prettier": "^3.4.2",
    "sharp": "^0.33.5",
    "tailwindcss": "^3.4.16",
    "typescript": "^5.7.2",
    "vite": "^6.0.3",
    "vite-plugin-pwa": "^0.21.1",
    "vitest": "^2.1.8",
    "workbox-window": "^7.3.0"
  }
}

